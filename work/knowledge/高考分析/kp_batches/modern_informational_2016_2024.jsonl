{"schema_version": "exam-kp-candidate-batch-0.1", "batch_id": "MODERN-INFORMATIONAL-2016-2024", "exam_node_id": "GK-NC3-2017-Q001-2", "exam_id": "GK-NC3-2017", "year": 2017, "question_id": 1, "subquestion_code": "2", "question_type_l1": "objective_choice", "question_type_l2": "modern_reading_informational", "response_form": "objective_informational_reading", "analysis_scope": "question_segment_with_possible_related_context", "candidate_atomic_exam_point": "现代文信息筛选、概念理解、归纳与推断", "candidate_ability_action": "对照原文筛选、整合并判断信息", "candidate_basis": "题型标签、题干任务和解析候选中的信息阅读考点描述；非正式知识点", "prompt_excerpt": "下列对原文论证的相关分析，不正确的一项是（3分） A.围绕着乡村记忆的保护，文章逐层递进地论证了留住乡愁的必要性和可行性。 B.文章将乡村记忆分为物质文化和非物质文化两个方面，并论及了二者的有机联系。 C.文章提出以综合甄选的方式选择保留哪些乡村记忆，并举例说明了甄选的标准。 D.认为乡村与人的情感、记忆密切相关，这是文章论述城镇化与乡愁关系的前提。", "prompt_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NC3-2017/segments/question/Q001.md", "prompt_source_pdf": "Data/2008-2024·（四川）语文高考真题/2017年高考语文试卷（新课标Ⅲ卷）（空白卷）.pdf", "analysis_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NC3-2017/segments/analysis/Q001.md", "analysis_source_sha256": "2a59e89dffcdc9e4d30b4af089480fdbce78d2fb65698fc1a3023bae76710e91", "answer_candidate": null, "answer_candidate_method": "objective_answer_not_auto_extracted", "answer_candidate_status": "objective_candidate_source", "analysis_contains_answer_marker": true, "upstream_answer_source_status": "candidate_unverified", "source_authority_status": "unverified_local_provided", "score_candidate": 3, "score_status": "printed_section_total_visual_check", "knowledge_evidence_excerpt": "", "ability_level_candidates": [], "subskill_candidates": ["信息筛选", "概念理解", "归纳概括", "推断验证"], "manual_review_gate": "objective_answer_and_evidence_review_required", "source_warnings": ["Q1 题段末尾出现孤立“众 人”并黏连下一小问标记，疑为 OCR/排版污染；派生提示截断该残片，原始题段不改写。"], "ocr_status": "suspected_ocr_or_watermark_noise", "kp_id": "N/A", "mapping_level": "M0", "review_status": "candidate_only", "na_reason": "客观题答案独立核验与教材KP双向证据尚未闭合。"}
