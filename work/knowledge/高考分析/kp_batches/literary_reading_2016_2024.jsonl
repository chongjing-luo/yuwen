{"schema_version": "exam-kp-candidate-batch-0.1", "batch_id": "LITERARY-READING-2016-2024", "exam_node_id": "GK-NCA-2021-Q007-TOP", "exam_id": "GK-NCA-2021", "year": 2021, "question_id": 7, "subquestion_code": "TOP", "question_type_l1": "reading_subjective", "question_type_l2": "literary_reading", "response_form": "literary_reading_response", "analysis_scope": "question_segment_with_possible_related_context", "candidate_atomic_exam_point": "文学作品形象、语言、结构、主题与鉴赏表达", "candidate_ability_action": "理解文本并筛选、概括文学作品信息", "candidate_basis": "题型标签、题干任务和解析候选中的文学阅读考点描述；非正式知识点", "prompt_excerpt": "7.下列对本文相关内容和艺术特色的分析鉴赏，不正确的一项是（）\nA. 文章以童年时代的一段记忆开头，既点出了作者与普希金结缘之早，也自然地引出下文对访问普希金流放地的期待。\nB. 当地出版的普希金选集虽然收集了他最优秀的作品，但作者并不满足，认为这无助于人们了解完整、复杂、真正的普希金。C. 满地密叶的林荫道，秀美静谧的庄园，若有若无的细雨，这些环境描写，将寻访者的怀念、景仰与惆怅渲染得更加深切。\nD. 文章结尾，作者由普希金的痛苦和命运生发开去，将“喜欢天才的命运还是庸人的生活”这一问题置于读者面前，启人深思。", "prompt_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NCA-2021/segments/question/Q007.md", "prompt_source_pdf": "Data/2008-2024·（四川）语文高考真题/2021年高考语文试卷（全国甲卷）（空白卷）.pdf", "analysis_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NCA-2021/segments/analysis/Q007.md", "analysis_source_sha256": "cbf654eeda6f831538a5115c02c52b4a55170fbb1406a42dd2c7fdb1de04c8da", "answer_candidate": null, "answer_candidate_method": "literary_response_not_auto_extracted", "answer_candidate_status": "literary_candidate_source", "analysis_contains_answer_marker": false, "upstream_answer_source_status": "candidate_unverified", "source_authority_status": "unverified_local_provided", "score_candidate": 3, "score_status": "candidate_group_allocation", "knowledge_evidence_excerpt": "", "ability_level_candidates": [], "subskill_candidates": ["形象鉴赏", "语言品味", "结构作用", "主题概括", "开放探究"], "manual_review_gate": "literary_answer_and_scoring_review_required", "source_warnings": [], "ocr_status": "not_flagged_in_slice_review", "kp_id": "N/A", "mapping_level": "M0", "review_status": "candidate_only", "na_reason": "文学阅读答案/评分独立核验与教材KP双向证据尚未闭合。"}
