{"schema_version": "exam-kp-candidate-batch-0.1", "batch_id": "LITERARY-READING-2016-2024", "exam_node_id": "GK-NCA-2024-Q007-TOP", "exam_id": "GK-NCA-2024", "year": 2024, "question_id": 7, "subquestion_code": "TOP", "question_type_l1": "reading_subjective", "question_type_l2": "literary_reading", "response_form": "literary_reading_response", "analysis_scope": "question_segment_with_possible_related_context", "candidate_atomic_exam_point": "文学作品形象、语言、结构、主题与鉴赏表达", "candidate_ability_action": "结合文本证据赏析语言、形象与表达效果", "candidate_basis": "题型标签、题干任务和解析候选中的文学阅读考点描述；非正式知识点", "prompt_excerpt": "7. 下列对文本相关内容和艺术特色的分析鉴赏，不正确的一项是（）\nA.文章第一段写乌乡的清晨，作者感受着风与光，视线从脚下草、身边树，推展至天际寒星，再收回到\n农家炊烟，心情和笔触都从容舒缓。\nB. 霜降夜攀谈中，作者感觉到“一些亮点像阵雨打湿心头，渗入静夜植物的根须”，既实写外在景致的变V\n动，又虚写心中灵感的滋生。个年轻人踩过草木灰离家远行，这些点\n滴细节都带有乌乡生活的温度。\nD. 本文不仅记录了作者本人在乌乡小住的感受，还提及不少与当地生活息息相关的话题，如农事收成、\n动物保护等，侧面反映了乡村的发展。", "prompt_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NCA-2024/segments/question/Q007.md", "prompt_source_pdf": "Data/2008-2024·（四川）语文高考真题/2024年高考语文试卷（全国甲卷）（空白卷）.pdf", "analysis_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NCA-2024/segments/analysis/Q007.md", "analysis_source_sha256": "48d513823e5d5045d63c80a0ebb18b744d655d338a3ea9c8527fb3bf49a73359", "answer_candidate": null, "answer_candidate_method": "literary_response_not_auto_extracted", "answer_candidate_status": "literary_candidate_source", "analysis_contains_answer_marker": false, "upstream_answer_source_status": "candidate_unverified", "source_authority_status": "unverified_local_provided", "score_candidate": 3, "score_status": "question_level_candidate", "knowledge_evidence_excerpt": "", "ability_level_candidates": [], "subskill_candidates": ["形象鉴赏", "语言品味", "结构作用", "主题概括", "开放探究"], "manual_review_gate": "literary_answer_and_scoring_review_required", "source_warnings": [], "ocr_status": "not_flagged_in_slice_review", "kp_id": "N/A", "mapping_level": "M0", "review_status": "candidate_only", "na_reason": "文学阅读答案/评分独立核验与教材KP双向证据尚未闭合。"}
