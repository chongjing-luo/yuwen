{"schema_version": "exam-kp-candidate-batch-0.1", "batch_id": "POETRY-APPRECIATION-2016-2024", "exam_node_id": "GK-NC3-2017-Q005-1", "exam_id": "GK-NC3-2017", "year": 2017, "question_id": 5, "subquestion_code": "1", "question_type_l1": "reading_subjective", "question_type_l2": "poetry_appreciation", "response_form": "free_response_poetry_appreciation", "analysis_scope": "shared_top_level_analysis_segment", "candidate_atomic_exam_point": "古诗词形象、语言、表达技巧与思想情感鉴赏", "candidate_ability_action": "结合全诗分析形象、语言、技巧或情感", "candidate_basis": "题型标签、题干任务和解析候选中的鉴赏考点描述；非正式知识点", "prompt_excerpt": "以下对本诗的理解和分析，不正确的两项是 A．《长恨歌》和《秦中吟》都是白居易的得意之作，能够作为其诗歌创作的代表。 B． 元稹常常私下对白居易的诗歌进行模仿，这从侧面说明了白诗较高的创作水准。 C． 白居易在诗中称呼李绅为“短李”，也隐含着不太认可李绅诗歌创作的意思。 D. 作者坚信自己必将因文学成就而名扬后世，因此并不介意在当时是否得到认可。 二 E．在诗的最后两句中，白居易称，自己新编出的诗集可以成为自我炫耀的资本。", "prompt_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NC3-2017/segments/question/Q005.md", "prompt_source_pdf": "Data/2008-2024·（四川）语文高考真题/2017年高考语文试卷（新课标Ⅲ卷）（空白卷）.pdf", "analysis_source": "Data/2008-2024·（四川）语文高考真题/exam_extract/GK-NC3-2017/segments/analysis/Q005.md", "analysis_source_sha256": "c3dcb74d4f446d397460d8c88461c00cf1a52e435a2b8eecc75185dc1e1512bd", "answer_candidate": null, "answer_candidate_method": "poetry_free_response_not_auto_extracted", "answer_candidate_status": "poetry_candidate_source", "analysis_contains_answer_marker": true, "upstream_answer_source_status": "candidate_unverified", "source_authority_status": "unverified_local_provided", "score_candidate": 5, "score_status": "printed_section_total_visual_check", "knowledge_evidence_excerpt": "5．（11分）（二）古代诗歌阅读，阅读下面这首唐诗，完成下列各题。编集拙诗，成十一五卷，因题卷末，戏赠元九、李二十①白居易一篇长恨有风情②，十首秦吟近正声③。每被老元偷格律，苦教短李伏歌行④。世间富贵应无分，身后文章合有名。莫怪气粗言语大，新排十五卷诗成。", "ability_level_candidates": [], "subskill_candidates": ["炼字炼句", "意象与情感", "表达技巧", "形象概括"], "manual_review_gate": "poetry_answer_and_scoring_review_required", "source_warnings": [], "ocr_status": "not_flagged_in_slice_review", "kp_id": "N/A", "mapping_level": "M0", "review_status": "candidat