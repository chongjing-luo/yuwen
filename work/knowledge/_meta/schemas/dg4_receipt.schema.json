{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuwen:dg4-receipt:2.0-textbook-eval-1",
  "title": "DG4 Merge Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliverable_id", "artifact_version", "content_sha256", "pre_merge_file_sha256", "post_merge_file_sha256", "content_sha_unchanged", "whitelist_diff", "review_refs", "transition_id", "validator_run_id", "impact_items"],
  "properties": {
    "schema_version": {"const": "2.0-textbook-eval-1"},
    "deliverable_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "pre_merge_file_sha256": {"$ref": "#/$defs/sha256"},
    "post_merge_file_sha256": {"$ref": "#/$defs/sha256"},
    "content_sha_unchanged": {"const": true},
    "whitelist_diff": {"type": "array", "items": {"$ref": "#/$defs/diff"}},
    "review_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 2, "uniqueItems": true},
    "transition_id": {"type": "string", "pattern": "^TR-[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "validator_run_id": {"type": "string", "pattern": "^VAL-[0-9]{8}-[0-9]{6}[+-][0-9]{4}$"},
    "impact_items": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "category", "allowed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "category": {"enum": ["front_matter.status", "front_matter.reviewers", "lifecycle_metadata", "ledger", "transition", "review_ref"]},
        "allowed": {"const": true},
        "note": {"type": "string"}
      }
    }
  }
}
