{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence V2 Candidate",
  "type": "object",
  "required": ["evidence_id", "claim_id", "target_id", "field_path", "claim_type", "source_id", "artifact_id", "source_level", "carrier_type", "locator_type", "locator", "support_relation", "verification_status", "verifier", "verified_at"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"},
    "claim_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "field_path": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["Q", "F", "I", "M", "R", "E", "D"]},
    "source_id": {"type": "string"},
    "artifact_id": {"type": "string"},
    "source_level": {"enum": ["S1", "S2", "S3", "S4"]},
    "carrier_type": {"type": "string"},
    "locator_type": {"enum": ["pdf", "html", "image", "derived_calculation"]},
    "locator": {"type": "object", "minProperties": 1},
    "exact_quote": {"type": ["string", "null"]},
    "support_relation": {"enum": ["supports", "context", "contradicts"]},
    "verification_status": {"enum": ["unverified", "verified", "conflict", "rejected"]},
    "verifier": {"type": ["string", "null"]},
    "verified_at": {"type": ["string", "null"]},
    "na_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
