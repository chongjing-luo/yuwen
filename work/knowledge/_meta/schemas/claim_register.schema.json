{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuwen:claim-register:2.0-textbook-eval-1",
  "title": "Claim Register for DG2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliverable_id", "artifact_version", "claims"],
  "properties": {
    "schema_version": {"const": "2.0-textbook-eval-1"},
    "deliverable_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "target_id", "field_path", "claim_class", "formal", "evidence_refs"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^CLM-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "target_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
        "claim_class": {"enum": ["Q", "F", "I", "M", "R", "E", "D"]},
        "formal": {"type": "boolean"},
        "text": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "locator_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "na": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/na"}
          ],
          "default": null
        }
      },
      "allOf": [
        {
          "if": {"properties": {"formal": {"const": true}}},
          "then": {"required": ["text", "evidence_refs"], "properties": {"evidence_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"formal": {"const": true}, "claim_class": {"const": "I"}}},
          "then": {"properties": {"evidence_refs": {"minItems": 2}}}
        },
        {
          "if": {"required": ["na"], "properties": {"na": {"type": "object"}}},
          "then": {"properties": {"evidence_refs": {"minItems": 0}}}
        }
      ]
    },
    "na": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "scope", "dependencies", "reviewer_agreement"],
      "properties": {
        "status": {"enum": ["not_applicable", "permitted_unavailable", "future_locked", "no_reliable_relation"]},
        "reason": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reviewer_agreement": {"const": true}
      }
    }
  }
}
