{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact.schema.json",
  "title": "Artifact V2 Candidate",
  "type": "object",
  "required": ["artifact_id", "source_id", "artifact_role", "carrier_type", "local_path", "byte_size", "sha256", "authenticity_status", "is_canonical", "repository_visibility"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^ART-[A-Z0-9-]+$"},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "artifact_role": {"type": "string", "minLength": 1},
    "carrier_type": {"enum": ["正式电子版", "纸本扫描件", "切分衍生", "OCR衍生", "网页快照", "图像", "计算结果"]},
    "local_path": {"type": "string", "minLength": 1},
    "original_url": {"type": ["string", "null"]},
    "acquired_at": {"type": ["string", "null"]},
    "page_count": {"type": ["integer", "null"], "minimum": 1},
    "byte_size": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derived_from": {"type": ["string", "null"]},
    "transform": {"type": ["string", "null"]},
    "authenticity_status": {"enum": ["unverified", "verified", "conflict", "rejected"]},
    "verification_scope": {"enum": ["content_and_identity", "integrity_and_lineage_only"]},
    "is_canonical": {"type": "boolean"},
    "repository_visibility": {"enum": ["public", "private_local"]}
  },
  "additionalProperties": false
}
