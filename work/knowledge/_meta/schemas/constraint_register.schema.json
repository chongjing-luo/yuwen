{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yuwen:constraint-register:2.0-textbook-eval-1",
  "title": "Constraint Register for DG2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deliverable_id", "artifact_version", "constraints"],
  "properties": {
    "schema_version": {"const": "2.0-textbook-eval-1"},
    "deliverable_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "constraints": {
      "type": "array",
      "items": {"$ref": "#/$defs/constraint"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "kind", "statement", "source_refs", "severity", "checked"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^CON-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "kind": {"enum": ["required", "forbidden", "boundary", "dependency", "na_guard", "role_separation"]},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "severity": {"enum": ["P0", "P1", "P2", "warning"]},
        "checked": {"type": "boolean"},
        "failure_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
