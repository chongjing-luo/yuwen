  "source": "work/语文备课系统_知识点提取研究计划.md §6.1–§6.10",
  "hard_rejections": [
    {"code": "R01", "rule": "关键事实错误、伪造或张冠李戴"},
    {"code": "R02", "rule": "直接引文不可定位、需证主张缺适配来源或I类解释少于两处文本证据"},
    {"code": "R03", "rule": "合编文本漏项、必填模块缺失或特殊内容包模板错误"},
    {"code": "R04", "rule": "把研究解释、学习提示、网络解析或OCR冒充规范来源结论"},
    {"code": "R05", "rule": "原子知识点缺主层级、映射理由或有效证据"},
    {"code": "R06", "rule": "把非M1记录称为高考直接衔接，或引用未登记真题"},
    {"code": "R07", "rule": "使用未验收上游生成下游成果"},
    {"code": "R08", "rule": "数量、ID、版本或链接不一致导致断链"},
    {"code": "R09", "rule": "使用非现行课标、改写任务群名称或把任务群当固定课型/教法"},
    {"code": "R10", "rule": "机械铺满四项核心素养，或把学业质量水平当作单课/知识点/题目难度标签"}
