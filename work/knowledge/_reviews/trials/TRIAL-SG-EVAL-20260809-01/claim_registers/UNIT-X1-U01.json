      "target_id": "TASK-X1-U01-02",
      "field_path": "/trial_inventory/TASK-X1-U01-02/statement",
      "claim_class": "D",
      "formal": false,
      "text": "“朗读全文，体会这些词语和句式的表达效果。”",
