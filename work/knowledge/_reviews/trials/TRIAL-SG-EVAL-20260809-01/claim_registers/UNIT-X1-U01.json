    },
    {
      "claim_id": "CLM-UNIT-X1-U01-0017",
      "target_id": "CAND-L-X1-U01-06",
      "field_path": "/trial_inventory/CAND-L-X1-U01-06/statement",
      "claim_class": "D",
      "formal": false,
      "text": "主任务群“中国革命传统作品研习”要求阅读、研讨革命传统作品及新闻、通讯、报告、演讲等实用文体，联系思想实际理解内容并学习写法；本单元以阅读比较、朗读研讨、实地调查、材料核验、写作和编辑构成三类语文活动的闭环。",
