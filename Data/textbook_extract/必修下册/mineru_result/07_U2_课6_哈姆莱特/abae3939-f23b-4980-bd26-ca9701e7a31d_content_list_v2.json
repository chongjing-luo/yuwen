                    {
                        "type": "text",
                        "content": "38"
                    }
                ]
            },
            "bbox": [
                97,
                940,
                121,
                954
            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
                        "content": "语文 必修下册"
                    }
                ]
