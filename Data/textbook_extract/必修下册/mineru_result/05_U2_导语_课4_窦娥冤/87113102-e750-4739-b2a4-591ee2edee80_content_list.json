    {
        "type": "page_footnote",
        "text": "n﹝陌〕量词，用于祭奠时所烧的纸钱，相当于“叠”。",
        "bbox": [
            531,
            818,
            902,
            835
        ],
        "page_idx": 2
    },
    {
        "type": "page_footnote",
        "text": "o﹝则是〕只当是。",
