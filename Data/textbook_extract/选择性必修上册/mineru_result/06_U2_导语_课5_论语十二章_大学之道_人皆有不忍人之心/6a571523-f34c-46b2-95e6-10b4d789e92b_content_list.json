        ],
        "page_idx": 1
    },
    {
        "type": "image",
        "img_path": "images/5ed09078b1d8da0b6f61cadc716a63baeff3fbcf730cca09d22a3ce858aa001d.jpg",
        "image_caption": [],
        "image_footnote": [
            "先师孔子行教像（拓本）"
        ],
        "bbox": [
            99,
            193,
