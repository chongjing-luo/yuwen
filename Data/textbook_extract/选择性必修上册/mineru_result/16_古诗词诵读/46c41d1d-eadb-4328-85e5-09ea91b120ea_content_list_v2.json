        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "p〔儿〕指侍僮。"
                    }
                ]
            },
            "bbox": [
                531,
                841,
                657,
                858
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "q〔将出〕牵出，拿出。"
                    }
                ]
            },
            "bbox": [
                531,
                858,
