        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "1925年"
                    }
                ]
            },
            "bbox": [
                626,
                526,
                687,
                543
            ]
        },
        {
            "type": "image",
            "content": {
                "image_source": {
                    "path": "images/ce1f7388e77d55f861ce664c49c73131dbaa53ba442c491a4c99cf3a9229adfd.jpg"
                },
