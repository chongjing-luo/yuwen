            },
            "bbox": [
                260,
                47,
                964,
                200
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "毛泽东手书《沁园春·长沙》"
                    }
                ]
            },
            "bbox": [
                292,
                219,
                492,
                237
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "沁园春·长沙<sup>a</sup>"
                    }
                ]
            },
            "bbox": [
                374,
                274,
                613,
                305
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "毛泽东"
                    }
                ]
            },
            "bbox": [
                452,
                329,
                519,
                348
            ]
        },
        {
            "type": "list",
            "content": {
                "list_type": "text_list",
                "attribute": "unordered",
                "list_items": [
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "独立寒秋，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "湘江北去，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "橘子洲 <sup>b</sup> 头。"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "看万山红遍，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "层林尽染 <sup>c</sup>；"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "漫江 <sup>d</sup> 碧透，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "百舸 <sup>e</sup> 争流。"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "鹰击长空，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "鱼翔浅底 <sup>f</sup>，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "万类霜天竞自由 <sup>g</sup>。 怅 <sup>h</sup> 寥廓 <sup>i</sup>，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "问苍茫 <sup>j</sup> 大地，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "谁主 <sup>k</sup> 沉浮 <sup>l</sup> ？携来百侣<sup>a</sup> 曾游。"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "忆往昔峥嵘岁月稠<sup>b</sup>。恰同学少年，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "风华正茂 <sup>c</sup>；"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "书生意气，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "挥斥方遒 <sup>d</sup>。"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "指点江山，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "激扬文字 <sup>e</sup>，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "粪土当年万户侯<sup>f</sup>。曾记否，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "到中流 <sup>g</sup> 击水 <sup>h</sup>，"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "浪遏<sup>i</sup> 飞舟？"
                            }
                        ]
                    }
                ]
            },
            "bbox": [
                401,
                403,
                579,
                724
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "a 选自《毛泽东诗词集》（中央文献出版社1996年版）。"
                    }
                ]
            },
            "bbox": [
                92,
                766,
                457,
                784
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "b〔橘子洲〕又名水陆洲，在长沙城西的湘江中。"
                    }
                ]
            },
            "bbox": [
                94,
                784,
                433,
                803
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "c〔层林尽染〕山上一层层的树林全都经霜变红，像 染过一样。"
                    }
                ]
            },
            "bbox": [
                94,
                802,
                467,
                838
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "g〔万类霜天竞自由〕万物都在深秋竞相自由地活动。霜天，深秋天气。"
                    }
                ]
            },
            "bbox": [
                517,
                766,
                890,
                802
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "d〔漫江〕满江。漫，遍布。"
                    }
                ]
            },
            "bbox": [
                94,
                838,
                297,
                857
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "e〔舸（ɡě）〕大船。这里泛指船只。"
                    }
                ]
            },
            "bbox": [
                94,
                856,
                351,
                875
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "h〔怅（chàng）〕失意，不畅快。这里用来表达由深思而引发的激昂慷慨的心绪。"
                    }
                ]
            },
            "bbox": [
                517,
                802,
                892,
                838
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "f〔鹰击长空，鱼翔浅底〕鹰在广阔的天上飞，鱼在清澈的水里游。击，搏击，这里形容飞得矫健有力。翔，本指鸟盘旋飞翔，这里形容鱼游得轻快自由。"
                    }
                ]
            },
            "bbox": [
                94,
                873,
                468,
                928
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "i〔寥廓〕指宇宙高远辽阔。"
                    }
                ]
            },
            "bbox": [
                517,
                838,
                721,
                857
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "j〔苍茫〕旷远迷茫。"
                    }
                ]
            },
            "bbox": [
                517,
                856,
                675,
                875
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "k〔主〕主宰。"
                    }
                ]
            },
            "bbox": [
                519,
                875,
                630,
                891
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "l〔沉浮〕这里指盛衰。"
                    }
                ]
            },
            "bbox": [
                519,
                891,
                689,
                910
            ]
        },
        {
            "type": "page_number",
            "content": {
                "page_number_content": [
                    {
                        "type": "text",
                        "content": "2"
                    }
                ]
            },
            "bbox": [
                95,
                940,
                114,
                954
            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
                        "content": "语文 必修上册"
                    }
                ]
            },
