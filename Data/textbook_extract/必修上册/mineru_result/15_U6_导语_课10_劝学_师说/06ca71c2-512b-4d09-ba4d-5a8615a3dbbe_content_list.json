    },
    {
        "type": "image",
        "img_path": "images/83de6f68ff03e7c66db59eaf88fe3a92cd2f27297d14f207f1b445b483ec7246.jpg",
        "image_caption": [],
        "image_footnote": [
            "杏坛图（南宋版画）"
        ],
        "bbox": [
            97,
