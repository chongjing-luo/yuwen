                892,
                839
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "j〔敛裾（jū）〕提着衣襟。裾，衣襟。"
                    }
                ]
            },
            "bbox": [
                517,
                840,
                779,
                858
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "k〔消受〕享受。多用于否定式。"
                    }
                ]
            },
            "bbox": [
                519,
                858,
                747,
                876
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "l〔《西洲曲》〕南朝乐府诗，描写青年女子思念意中人的痛苦。"
                    }
                ]
            },
            "bbox": [
                517,
