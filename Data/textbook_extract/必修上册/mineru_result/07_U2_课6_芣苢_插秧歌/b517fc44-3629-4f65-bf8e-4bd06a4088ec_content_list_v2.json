                787
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "e〔掇（duō）〕拾取，摘取。"
                    }
                ]
            },
            "bbox": [
                105,
                840,
                314,
                858
            ]
        },
        {
            "type": "page_footnote",
            "content": {
                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "k〔胛〕肩胛。"
                    }
                ]
            },
            "bbox": [
                531,
