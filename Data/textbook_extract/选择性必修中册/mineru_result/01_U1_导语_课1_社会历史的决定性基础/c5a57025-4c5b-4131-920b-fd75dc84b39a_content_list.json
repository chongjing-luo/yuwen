    {
        "type": "image",
        "img_path": "images/fb80f5bf23bffbdbb4370d66eb08cbb58302a14f6b173182d4d9869311aa1b58.jpg",
        "image_caption": [
            "恩格斯在新形势下捍卫和发展马克思主义（木刻）  李焕民 作"
        ],
        "image_footnote": [],
        "bbox": [
            178,
            303,
            653,
