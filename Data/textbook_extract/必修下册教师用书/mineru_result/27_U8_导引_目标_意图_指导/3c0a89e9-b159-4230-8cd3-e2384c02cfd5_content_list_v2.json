            ]
        },
        {
            "type": "page_footer",
            "content": {
                "page_footer_content": [
                    {
                        "type": "text",
                        "content": "普通高中教科书 教师教学用书 语文 必修 下册 │"
                    }
                ]
            },
            "bbox": [
