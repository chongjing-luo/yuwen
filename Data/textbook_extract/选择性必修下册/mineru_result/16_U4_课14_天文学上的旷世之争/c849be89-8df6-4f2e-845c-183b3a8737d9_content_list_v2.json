                "page_footnote_content": [
                    {
                        "type": "text",
                        "content": "e〔虞喜（281—356）〕字仲宁，会稽余姚（今属浙江）人，东晋天文学家。"
                    }
                ]
            },
            "bbox": [
                92,
                869,
                468,
                901
            ]
        },
        {
            "type": "page_number",
            "content": {
                "page_number_content": [
                    {
                        "type": "text",
